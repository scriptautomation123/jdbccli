@startuml typed-api-flow
title <color:#E0E0E0>JDBC CLI — Typed API: Full Call Flow</color>\n<size:12><color:#A8C7FA>Principal Engineer Reference Diagram</color></size>

skinparam backgroundColor #0D1117
skinparam defaultFontName "Courier New"
skinparam defaultFontSize 11
skinparam maxMessageSize 120
skinparam wrapWidth 120

skinparam sequence {
  ArrowColor #58A6FF
  ActorBorderColor #58A6FF
  LifeLineBorderColor #30363D
  LifeLineBackgroundColor #161B22
  ParticipantBorderColor #58A6FF
  ParticipantBackgroundColor #161B22
  ParticipantFontColor #E6EDF3
  NoteBackgroundColor #0D1117
  NoteBorderColor #F0883E
  NoteFontColor #E6EDF3
  DividerBackgroundColor #1F2D1F
  DividerBorderColor #3FB950
  DividerFontColor #3FB950
  BoxBorderColor #30363D
  BoxFontColor #8B949E
  GroupBackgroundColor #0D2B1A
  GroupBorderColor #3FB950
  GroupFontColor #E6EDF3
  GroupBodyBackgroundColor #0D1117
}

skinparam note {
  BackgroundColor #0D1117
  BorderColor #F0883E
  FontColor #E6EDF3
}

'──────────────────────────────────────────────────────
' PARTICIPANTS  (filenames shown in note breadcrumbs)
'──────────────────────────────────────────────────────
participant "<color:#3FB950>**Caller**</color>\n<color:#8B949E>(Application Code)</color>" as CALLER #1A2F1A

box "<color:#A8C7FA>Public API Layer</color>" #0D1F33
  participant "<color:#79C0FF>**JdbcCliLibrary**</color>" as LIB #0D1F33
  participant "<color:#79C0FF>**JdbcCliTypedApi**</color>" as TAPI #0D1F33
end box

box "<color:#FFD700>Service Layer</color>" #2B2200
  participant "<color:#F0C040>**TypedSqlExecutorService**</color>" as SVC #2B2200
end box

box "<color:#FF7B72>JDBC Execution Layer</color>" #2D1515
  participant "<color:#FF7B72>**QueryExecutorTyped**</color>" as QEXEC #2D1515
  participant "<color:#FF7B72>**DefaultResultSetHandlerFactory**</color>" as FACTORY #2D1515
end box

box "<color:#D2A8FF>Row Mapping Layer</color>" #22162B
  participant "<color:#D2A8FF>**ObjectResultHandler**</color>" as HANDLER #22162B
  participant "<color:#C9B1FF>**JdbcPropertyAccessor**</color>" as ACCESSOR #22162B
  participant "<color:#C9B1FF>**TypeHandlerPropertyAccessor**</color>" as THACCESSOR #22162B
end box

box "<color:#3FB950>Type System Layer</color>" #1A2F1A
  participant "<color:#56D364>**TypeHandlerRegistry**</color>" as REGISTRY #1A2F1A
  participant "<color:#56D364>**TypeHandler\<T\>**</color>" as THANDLER #1A2F1A
end box

CALLER -> LIB : **JdbcCliLibrary.withPassword("secret")**
activate LIB

note over LIB
  <b><color:#3FB950>[1]</color> <color:#E6EDF3>Entry Point: Caller bootstraps the library</color></b>
  <color:#6E7681><size:9>com.company.app.service</size></color>  <b><color:#A8C7FA>JdbcCliLibrary.java</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#8B949E>// Factory shortcut — wires the full typed pipeline</color>
  <color:#FF7B72>public static</color> JdbcCliLibrary <color:#D2A8FF>withPassword</color>(String pw) {
    <color:#FF7B72>return new</color> JdbcCliLibrary(<color:#FF7B72>new</color> PasswordResolver(() -> pw));
  }
  <color:#FF7B72>private</color> JdbcCliLibrary(PasswordResolver resolver) {
    <color:#FF7B72>this</color>.typedApi = <color:#FF7B72>new</color> <color:#79C0FF>JdbcCliTypedApi</color>(<color:#FF7B72>new</color> <color:#79C0FF>TypedSqlExecutorService</color>(resolver));
  }
end note

LIB --> CALLER : library instance
deactivate LIB

CALLER -> TAPI : **lib.typed().runSqlTypedApi(\n  dbType, jdbcUrl, user, sql, params, Employee.class, vaultCfg)**
activate TAPI

note over TAPI
  <b><color:#3FB950>[2]</color> <color:#E6EDF3>Caller invokes typed query via facade</color></b>
  <color:#6E7681><size:9>com.company.app.service</size></color>  <b><color:#A8C7FA>JdbcCliTypedApi.java</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#8B949E>// Validates, builds SqlRequest, delegates to executor service</color>
  <color:#FF7B72>public</color> <T> List<T> <color:#D2A8FF>runSqlTypedApi</color>(..., Class<T> resultClass, ...) {
    Objects.<color:#D2A8FF>requireNonNull</color>(resultClass, <color:#A5D6FF>"resultClass cannot be null"</color>);
    <color:#FF7B72>final</color> SqlRequest request = <color:#FF7B72>new</color> <color:#79C0FF>SqlRequest</color>(
        <color:#FF7B72>new</color> DatabaseRequest(dbType, database, user, <color:#D2A8FF>resolvedVault</color>(cfg)),
        Optional.<color:#D2A8FF>of</color>(sql), Optional.<color:#D2A8FF>empty</color>(),
        params != <color:#FF7B72>null</color> ? params : List.<color:#D2A8FF>of</color>());
    <color:#FF7B72>return</color> typedQueryExecutorService.<color:#D2A8FF>execute</color>(request, resultClass);
  }
end note

TAPI -> SVC : **execute(SqlRequest, Employee.class)**
activate SVC

note over SVC
  <b><color:#3FB950>[3]</color> <color:#E6EDF3>Service dispatches via exhaustive sealed-type switch</color></b>
  <color:#6E7681><size:9>com.company.app.service.service</size></color>  <b><color:#A8C7FA>TypedSqlExecutorService.java</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#8B949E>// Sealed switch — compile error if a new DbRequest subtype is added</color>
  <color:#FF7B72>return switch</color> (request) {
    <color:#FF7B72>case</color> SqlRequest r       -> <color:#D2A8FF>executeTypedQuery</color>(r, resultClass);
    <color:#FF7B72>case</color> ProcedureRequest p  -> <color:#FF7B72>throw new</color> QueryExecutionException(...);
  };

  <color:#8B949E>// Runs on a virtual thread — JDBC blocking I/O does NOT pin a carrier</color>
  executionContext.<color:#D2A8FF>executeWithPasswordResolution</color>(request,
      conn -> <color:#79C0FF>QueryExecutorTyped</color>.<color:#D2A8FF>executeTyped</color>(
          conn, sql, params, resultClass));
end note

SVC -> QEXEC : **QueryExecutorTyped.executeTyped(conn, sql, params, Employee.class)**
activate QEXEC

note over QEXEC
  <b><color:#3FB950>[4]</color> <color:#E6EDF3>SQL execution: PreparedStatement + ResultSet</color></b>
  <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>QueryExecutorTyped.java</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#FF7B72>try</color> (PreparedStatement pstmt = conn.<color:#D2A8FF>prepareStatement</color>(sql)) {
    <color:#FF7B72>for</color> (<color:#FF7B72>int</color> i = <color:#79C0FF>0</color>; i < params.<color:#D2A8FF>size</color>(); i++)
      pstmt.<color:#D2A8FF>setObject</color>(i + <color:#79C0FF>1</color>, params.<color:#D2A8FF>get</color>(i));
    <color:#FF7B72>try</color> (ResultSet rs = pstmt.<color:#D2A8FF>executeQuery</color>()) {
      <color:#8B949E>// ↓ LRU cache hit = O(1) after first call per (class, column-set)</color>
      ResultSetHandler<T> handler =
          <color:#79C0FF>DefaultResultSetHandlerFactory</color>.<color:#D2A8FF>getHandler</color>(resultClass, rs.<color:#D2A8FF>getMetaData</color>());
      <color:#FF7B72>return new</color> QueryResult.TypedResult<>(handler.<color:#D2A8FF>handleAll</color>(rs), ...);
    }
  }
end note

QEXEC -> FACTORY : **getHandler(Employee.class, metaData)**
activate FACTORY

note over FACTORY
  <b><color:#3FB950>[5]</color> <color:#E6EDF3>Factory: LRU cache lookup</color>  <color:#8B949E><size:10>key = "ClassName:col1,col2,..."</size></color></b>
  <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>DefaultResultSetHandlerFactory.java</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#8B949E>// Bounded LRU — max 1000 entries, access-order LinkedHashMap</color>
  String key = <color:#79C0FF>ObjectResultHandler</color>.<color:#D2A8FF>createCacheKey</color>(type, metaData);
  <color:#8B949E>// e.g. key = "Employee:id,first_name,last_name,dept,salary"</color>

  <color:#FF7B72>synchronized</color> (CACHE_LOCK) {
    <color:#FF7B72>if</color> (CACHE.<color:#D2A8FF>containsKey</color>(key)) <color:#FF7B72>return</color> CACHE.<color:#D2A8FF>get</color>(key);  <color:#8B949E>// HIT</color>
  }
  ResultSetHandler<T> handler = <color:#FF7B72>new</color> <color:#79C0FF>ObjectResultHandler</color><>(type, metaData); <color:#8B949E>// built outside lock</color>
  <color:#FF7B72>synchronized</color> (CACHE_LOCK) { CACHE.<color:#D2A8FF>putIfAbsent</color>(key, handler); }    <color:#8B949E>// double-check</color>
  <color:#FF7B72>return</color> handler;
end note

alt <color:#3FB950>**✓ HIT**</color> — O(1) synchronized lookup <color:#8B949E>(99% of calls after warmup)</color>
  note over FACTORY
    <color:#3FB950>**Cache hit path**</color> — returns immediately
    <color:#8B949E>Skips steps 6 + 7 entirely (no reflection, no accessor build)</color>
    <color:#8B949E>ObjectResultHandler<Employee> was built on first call and stored.</color>
  end note
  FACTORY --> QEXEC : <color:#3FB950>cached</color> ObjectResultHandler<Employee>
else <color:#FF7B72>**✗ MISS**</color> — first call for this (class + column-set) shape
  FACTORY -> HANDLER : **new ObjectResultHandler<>(Employee.class, metaData)**
  activate HANDLER

  note over HANDLER
    <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>ObjectResultHandler.java</color></b>
    <color:#30363D>────────────────────────────────────────────────────────────────</color>
    <color:#8B949E>// Reflection cost paid ONCE — result cached by factory</color>
    <color:#FF7B72>public</color> <color:#79C0FF>ObjectResultHandler</color>(Class<T> type, ResultSetMetaData meta) {
      <color:#FF7B72>this</color>.columnCount = meta.<color:#D2A8FF>getColumnCount</color>();
      <color:#FF7B72>this</color>.accessors   = <color:#D2A8FF>buildAccessors</color>(type, meta); <color:#8B949E>// JdbcPropertyAccessor[] by col index</color>
    }
    <color:#8B949E>// Per-row hot path: zero reflection, zero map lookups</color>
    <color:#FF7B72>public</color> T <color:#D2A8FF>handle</color>(ResultSet rs) {
      T obj = targetType.<color:#D2A8FF>getDeclaredConstructor</color>().<color:#D2A8FF>newInstance</color>();
      <color:#FF7B72>for</color> (<color:#FF7B72>int</color> i = <color:#79C0FF>0</color>; i < columnCount; i++)
        accessors[i].<color:#D2A8FF>setProperty</color>(obj, rs, i + <color:#79C0FF>1</color>);
      <color:#FF7B72>return</color> obj;
    }
  end note

  HANDLER -> ACCESSOR : **buildAccessors() per column**
  activate ACCESSOR

  note over ACCESSOR
    <b><color:#3FB950>[6]</color> <color:#E6EDF3>Accessor array build: column name → setter resolution</color>  <color:#8B949E><size:10>(once per shape)</size></color></b>
    <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>JdbcPropertyAccessor.java</color></b>
    <color:#30363D>────────────────────────────────────────────────────────────────</color>
    <color:#8B949E>// Resolves setter once per column during construction:</color>
    <color:#8B949E>// 1) Direct:          "salary"     → setSalary</color>
    <color:#8B949E>// 2) Underscore→camel: "first_name" → setFirstName</color>
    PropertyMatch match = <color:#D2A8FF>findSetter</color>(columnName, setters);
    <color:#FF7B72>if</color> (match.setter == <color:#FF7B72>null</color>)
      <color:#FF7B72>return</color> JdbcPropertyAccessor.<color:#D2A8FF>noOp</color>(columnName); <color:#8B949E>// unmapped col — silently skip</color>
    <color:#FF7B72>return</color> <color:#D2A8FF>createAccessorWithHandler</color>(columnName, match, registry);
  end note

  ACCESSOR --> HANDLER : NoOpAccessor or TypeHandlerPropertyAccessor
  deactivate ACCESSOR

  HANDLER -> THACCESSOR : **new TypeHandlerPropertyAccessor(propertyName, setter, handler)**
  activate THACCESSOR

  note over THACCESSOR
    <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>TypeHandlerPropertyAccessor.java</color></b>
    <color:#30363D>────────────────────────────────────────────────────────────────</color>
    <color:#8B949E>// Holds pre-resolved setter + type handler — called for EVERY row</color>
    <color:#FF7B72>private final</color> Method         setter;   <color:#8B949E>// pre-resolved, never looked up again</color>
    <color:#FF7B72>private final</color> TypeHandler<?> handler;  <color:#8B949E>// pre-resolved, converts JDBC → Java type</color>

    <color:#D2A8FF>@Override</color>
    <color:#FF7B72>public void</color> <color:#D2A8FF>setProperty</color>(Object target, ResultSet rs, <color:#FF7B72>int</color> col) {
      Object value = handler.<color:#D2A8FF>getResult</color>(rs, col);  <color:#8B949E>// convert JDBC value</color>
      setter.<color:#D2A8FF>invoke</color>(target, value);              <color:#8B949E>// direct Method.invoke — no lookup</color>
    }
  end note

  THACCESSOR -> REGISTRY : **TypeHandlerRegistry.getInstance().getHandler(String.class)**
  activate REGISTRY

  note over REGISTRY
    <b><color:#3FB950>[7]</color> <color:#E6EDF3>Type system: singleton registry resolves per-type JDBC converters</color></b>
    <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>TypeHandlerRegistry.java</color></b>
    <color:#30363D>────────────────────────────────────────────────────────────────</color>
    <color:#8B949E>// Singleton — ConcurrentHashMap, lock-free reads after init</color>
    <color:#FF7B72>private</color> <color:#79C0FF>TypeHandlerRegistry</color>() {
      <color:#D2A8FF>register</color>(String.<color:#FF7B72>class</color>,     ResultSet::<color:#D2A8FF>getString</color>);
      <color:#D2A8FF>register</color>(Integer.<color:#FF7B72>class</color>,    TypeHandlerRegistry::<color:#D2A8FF>getIntegerOrNull</color>);
      <color:#D2A8FF>register</color>(Long.<color:#FF7B72>class</color>,       TypeHandlerRegistry::<color:#D2A8FF>getLongOrNull</color>);
      <color:#D2A8FF>register</color>(BigDecimal.<color:#FF7B72>class</color>, ResultSet::<color:#D2A8FF>getBigDecimal</color>);
      <color:#D2A8FF>register</color>(LocalDate.<color:#FF7B72>class</color>,
          (rs, i) -> { <color:#FF7B72>var</color> d = rs.<color:#D2A8FF>getDate</color>(i); <color:#FF7B72>return</color> d != <color:#FF7B72>null</color> ? d.<color:#D2A8FF>toLocalDate</color>() : <color:#FF7B72>null</color>; });
      <color:#8B949E>// + all primitives, Date, Timestamp, byte[], Boolean, Object</color>
    }
    <color:#8B949E>// Null-safe int: rs.getInt() returns 0 for SQL NULL — must check wasNull()</color>
    <color:#FF7B72>private static</color> Integer <color:#D2A8FF>getIntegerOrNull</color>(ResultSet rs, <color:#FF7B72>int</color> col) {
      <color:#FF7B72>int</color> v = rs.<color:#D2A8FF>getInt</color>(col); <color:#FF7B72>return</color> rs.<color:#D2A8FF>wasNull</color>() ? <color:#FF7B72>null</color> : v;
    }
  end note

  REGISTRY -> THANDLER : **lambda / method-ref (e.g. ResultSet::getString)**
  activate THANDLER

  note over THANDLER
    <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>TypeHandler.java</color></b>
    <color:#30363D>────────────────────────────────────────────────────────────────</color>
    <color:#8B949E>// @FunctionalInterface — registered once, reused for every row</color>
    <color:#D2A8FF>@FunctionalInterface</color>
    <color:#FF7B72>public interface</color> <color:#79C0FF>TypeHandler</color><T> {
      T <color:#D2A8FF>getResult</color>(ResultSet rs, <color:#FF7B72>int</color> columnIndex) <color:#FF7B72>throws</color> SQLException;
    }
    <color:#8B949E>// Examples: ResultSet::getString,  (rs,i)->rs.getDate(i).toLocalDate()</color>
  end note

  THANDLER --> REGISTRY : TypeHandler<T>
  deactivate THANDLER

  REGISTRY --> THACCESSOR : TypeHandler<T>
  deactivate REGISTRY

  THACCESSOR --> HANDLER : TypeHandlerPropertyAccessor[]
  deactivate THACCESSOR

  HANDLER --> FACTORY : ObjectResultHandler<Employee> (accessor[] built)
  deactivate HANDLER

  FACTORY --> QEXEC : ObjectResultHandler<Employee> (now cached)
end

deactivate FACTORY

QEXEC -> HANDLER : **handler.handleAll(rs)**
activate HANDLER

note over HANDLER
  <b><color:#3FB950>[8]</color> <color:#E6EDF3>Hot path: every row mapped via pre-compiled accessor array</color></b>
  <color:#6E7681><size:9>com.company.app.typedapi</size></color>  <b><color:#A8C7FA>ObjectResultHandler.java  ← HOT PATH</color></b>
  <color:#30363D>────────────────────────────────────────────────────────────────</color>
  <color:#8B949E>// default method in ResultSetHandler — iterates all rows</color>
  <color:#FF7B72>while</color> (rs.<color:#D2A8FF>next</color>()) results.<color:#D2A8FF>add</color>(<color:#D2A8FF>handle</color>(rs));

  <color:#8B949E>// Per-row: indexed array loop — no reflection lookup, no map access</color>
  T obj = targetType.<color:#D2A8FF>getDeclaredConstructor</color>().<color:#D2A8FF>newInstance</color>();
  <color:#FF7B72>for</color> (<color:#FF7B72>int</color> i = <color:#79C0FF>0</color>; i < columnCount; i++)
    accessors[i].<color:#D2A8FF>setProperty</color>(obj, rs, i + <color:#79C0FF>1</color>);
  <color:#8B949E>//   └─ handler.getResult(rs, col)  reads JDBC value</color>
  <color:#8B949E>//      setter.invoke(target, value)  sets bean field</color>
end note

HANDLER --> QEXEC : List<Employee>
deactivate HANDLER

QEXEC --> SVC : QueryResult.TypedResult<Employee>
deactivate QEXEC

SVC --> TAPI : List<Employee>
deactivate SVC

TAPI --> CALLER : **List<Employee>**
deactivate TAPI

'──────────────────────────────────────────────────────
' PERFORMANCE LEGEND
'──────────────────────────────────────────────────────
legend right
  <color:#E6EDF3>**Performance characteristics**</color>
  <color:#30363D>───────────────────────────────────────────────────────</color>
  <color:#F0C040>First call (cache miss):</color>
    <color:#8B949E>•</color> <color:#D2A8FF>buildAccessors()</color>      <color:#8B949E>O(cols) reflection — paid once per shape</color>
    <color:#8B949E>•</color> <color:#D2A8FF>buildSetterMap()</color>      <color:#8B949E>O(methods) reflection — paid once</color>
    <color:#8B949E>•</color> <color:#D2A8FF>getHandler()</color>          <color:#8B949E>O(1) ConcurrentHashMap</color>

  <color:#3FB950>Subsequent calls (cache hit):</color>
    <color:#8B949E>•</color> <color:#56D364>Factory lookup</color>        <color:#8B949E>O(1) synchronized LinkedHashMap</color>
    <color:#8B949E>•</color> <color:#56D364>Per-row mapping</color>       <color:#8B949E>O(cols) array loop, direct invoke</color>

  <color:#FF7B72>Cache key:</color>  <color:#A5D6FF>"Employee:id,first_name,last_name,dept,salary"</color>
  <color:#FF7B72>LRU eviction:</color> <color:#8B949E>max 1000 entries, double-checked locking</color>
  <color:#F0C040>~18.5x faster than naive per-row reflection</color>
end legend

@enduml
